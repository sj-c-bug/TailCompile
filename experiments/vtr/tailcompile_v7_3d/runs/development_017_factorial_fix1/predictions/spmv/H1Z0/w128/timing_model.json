    "horizontal": "frequency-weighted mean over L4/L16 and both axes of median(hop_delay_ns / actual inclusive span_tiles)",
    "raw_units": {
      "C": "farad",
      "R": "ohm",
      "Tdel": "second",
      "span": "physical FPGA tile; inclusive RR channel coordinates"
    },
    "terminal": "one local ipin_cblock delay; source access included by horizontal driver amortization",
    "vertical": "resolved directional SG entry mux + sampled CHANZ wire, loaded by one L4-driver Cin"
  },
