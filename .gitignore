env.sh
.env
.env.*
logs/
*.pid
nohup.out

vtr_work/
failed_runs_code127_*/
interrupted_run_quarantine/

# Reproducible, large VTR flow intermediates (materialized by preparation scripts).
experiments/vtr/runs/

__pycache__/
*.py[cod]

*.zip
*.tar
*.tar.gz

experiments/vtr/tailcompile_v3_training/smoke_model/
experiments/vtr/tailcompile_v3_training/inference_smoke/
experiments/vtr/tailcompile_v3_training/checkpoint_smoke_*/*.pt
experiments/vtr/tailcompile_v3_training/model_width_conditioned/ranker_latest.pt

experiments/vtr/tailcompile_v3/*/4x4/pools/*/candidate_*.pt

experiments/vtr/tailcompile_v3/*/4x4/runs/*/*
!experiments/vtr/tailcompile_v3/*/4x4/runs/*/manifest.json
!experiments/vtr/tailcompile_v3/*/4x4/runs/*/vpr.out

# v4: keep compact evidence, exclude reproducible physical intermediates.
experiments/vtr/tailcompile_v4/runs/**/inputs/
experiments/vtr/tailcompile_v4/runs/**/*.pt
experiments/vtr/tailcompile_v4/runs/**/supply_run/*
!experiments/vtr/tailcompile_v4/runs/**/supply_run/manifest.json
!experiments/vtr/tailcompile_v4/runs/**/supply_run/vpr.out
experiments/vtr/tailcompile_v4/runs/**/runs/*/*
!experiments/vtr/tailcompile_v4/runs/**/runs/*/manifest.json
!experiments/vtr/tailcompile_v4/runs/**/runs/*/metrics.json
!experiments/vtr/tailcompile_v4/runs/**/runs/*/vpr.out

# v5: retain locked configs and compact evidence; exclude reproducible physical files.
experiments/vtr/tailcompile_v5/inputs/**/full/
experiments/vtr/tailcompile_v5/inputs/**/rr_w*/
experiments/vtr/tailcompile_v5/runs/**/inputs/**/full/
experiments/vtr/tailcompile_v5/runs/**/inputs/**/rr_w*/
experiments/vtr/tailcompile_v5/runs/**/confirm/**/inputs/
experiments/vtr/tailcompile_v5/runs/**/confirm/**/*.pt
experiments/vtr/tailcompile_v5/runs/**/confirm/**/supply_run/*
!experiments/vtr/tailcompile_v5/runs/**/confirm/**/supply_run/manifest.json
!experiments/vtr/tailcompile_v5/runs/**/confirm/**/supply_run/vpr.out
experiments/vtr/tailcompile_v5/runs/**/confirm/**/runs/*/*
!experiments/vtr/tailcompile_v5/runs/**/confirm/**/runs/*/manifest.json
!experiments/vtr/tailcompile_v5/runs/**/confirm/**/runs/*/metrics.json
!experiments/vtr/tailcompile_v5/runs/**/confirm/**/runs/*/vpr.out
experiments/vtr/tailcompile_v5/runs/**/screen/runs/**/default_s*/*
!experiments/vtr/tailcompile_v5/runs/**/screen/runs/**/default_s*/manifest.json
!experiments/vtr/tailcompile_v5/runs/**/screen/runs/**/default_s*/vpr.out

# v6.1: preserve compact reports and candidate placements, not large caches.
experiments/vtr/tailcompile_v61/runs/**/*.pt
experiments/vtr/tailcompile_v61/runs/**/candidates/**/runs/*/*
!experiments/vtr/tailcompile_v61/runs/**/candidates/**/runs/*/manifest.json
!experiments/vtr/tailcompile_v61/runs/**/candidates/**/runs/*/v61_metrics.json
!experiments/vtr/tailcompile_v61/runs/**/candidates/**/runs/*/vpr.out
experiments/vtr/tailcompile_v61/local_smoke/*.fplace

# v6.2: compact evidence only.
experiments/vtr/tailcompile_v62/runs/**/*.pt
experiments/vtr/tailcompile_v62/runs/**/pool/**/*.fplace
experiments/vtr/tailcompile_v62/runs/**/pool/**/*_binding.json
experiments/vtr/tailcompile_v62/runs/**/pool/**/*_lowering.json
experiments/vtr/tailcompile_v62/runs/**/labels/**/s*/*
!experiments/vtr/tailcompile_v62/runs/**/labels/**/s*/manifest.json
!experiments/vtr/tailcompile_v62/runs/**/labels/**/s*/v62_metrics.json
experiments/vtr/tailcompile_v62/runs/**/pilot/**/s*/*
!experiments/vtr/tailcompile_v62/runs/**/pilot/**/s*/manifest.json
!experiments/vtr/tailcompile_v62/runs/**/pilot/**/s*/v62_metrics.json
experiments/vtr/tailcompile_v62/runs/**/full/**/s*/*
!experiments/vtr/tailcompile_v62/runs/**/full/**/s*/manifest.json
!experiments/vtr/tailcompile_v62/runs/**/full/**/s*/v62_metrics.json

# v6.3: sync reports and small VPR evidence, exclude tensor caches and raw runs.
experiments/vtr/tailcompile_v63/runs/**/*.pt
experiments/vtr/tailcompile_v63/runs/**/pool/**/*.fplace
experiments/vtr/tailcompile_v63/runs/**/pool/**/*_binding.json
experiments/vtr/tailcompile_v63/runs/**/pool/**/*_lowering.json
experiments/vtr/tailcompile_v63/runs/**/labels/**/s*/*
!experiments/vtr/tailcompile_v63/runs/**/labels/**/s*/manifest.json
!experiments/vtr/tailcompile_v63/runs/**/labels/**/s*/v62_metrics.json
experiments/vtr/tailcompile_v63/runs/**/probe/**/s*/*
!experiments/vtr/tailcompile_v63/runs/**/probe/**/s*/manifest.json
!experiments/vtr/tailcompile_v63/runs/**/probe/**/s*/v62_metrics.json
experiments/vtr/tailcompile_v63/runs/**/evaluation/**/s*/*
!experiments/vtr/tailcompile_v63/runs/**/evaluation/**/s*/manifest.json
!experiments/vtr/tailcompile_v63/runs/**/evaluation/**/s*/v62_metrics.json

# v6.4: freeze the width-sweep plan and compact trial evidence, not raw VPR data.
experiments/vtr/tailcompile_v64/runs/**/runs/**/s*/*
!experiments/vtr/tailcompile_v64/runs/**/runs/**/s*/manifest.json
!experiments/vtr/tailcompile_v64/runs/**/runs/**/s*/trial.json
experiments/vtr/tailcompile_v64/runs/**/_interrupted_history/
